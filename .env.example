# ─── OBLIGATOIRE ───
GROQ_API_KEY=colle_ta_cle_groq_ici

# ─── RECOMMANDÉ SUR RENDER (disque persistant) ───
AUTH_DIR=/data/auth

# ─── CONNEXION PAR CODE DE JUMELAGE (au lieu du QR) ───
# Numéro DU BOT (celui que tu connectes), format international sans + ni espaces.
# Si renseigné => tu reçois un code à 8 caractères dans les logs. Vide => QR code.
BOT_NUMBER=33612345678

# ─── OPTIONNEL (valeurs par défaut entre parenthèses) ───
BOT_NAME=EDITH
GROQ_MODEL=llama-3.3-70b-versatile
PREFIX=!edith

# En privé : répondre à tout (true) ou seulement avec le préfixe (false)
PRIVATE_NO_PREFIX=true

# Ne répondre QU'À ton numéro (indicatif + numéro, ex 33612345678). Vide = tout le monde.
OWNER_NUMBER=

# Personnalité (laisse vide pour le défaut)
# SYSTEM_PROMPT=Tu es mon assistant perso...

HISTORY_LENGTH=8

# Répondre aussi quand TU écris depuis le téléphone du bot, avec le préfixe (true/false)
ALLOW_SELF=true

# Efface la session au prochain démarrage si les clés sont cassées (Bad MAC). REMETS À false après jumelage !
RESET_SESSION=false
